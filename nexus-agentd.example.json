{
  "initialized": false,
  "listen": {
    "host": "0.0.0.0",
    "port": 8787
  },
  "workspaceRoots": [
    "/data/repos"
  ],
  "apiKeys": [],
  "maxRequestBytes": 1048576,
  "maxAttachmentBytes": 33554432,
  "requestTimeoutMs": 30000,
  "promptTimeoutMs": 1800000,
  "cleanupIntervalMs": 60000,
  "maxSessions": 64,
  "maxSseConnections": 128,
  "maxConnections": 256,
  "sessionTtlMs": 86400000,
  "quotas": {
    "maxSessionsPerKey": 16,
    "maxRunningRunsPerKey": 4,
    "maxSsePerKey": 8,
    "maxUploadBytesPerKey": 33554432
  },
  "history": { "maxRuns": 1000, "retentionDays": 30, "maxBytes": 67108864 },
  "artifacts": { "retentionDays": 30, "maxBytes": 536870912, "maxArtifactBytes": 12582912, "maxQueuedBytes": 67108864 },
  "agents": {
    "custom": {
      "protocol": "acp",
      "driver": "stdio",
      "name": "Custom ACP",
      "enabled": false,
      "command": "your-acp-agent",
      "args": [],
      "probeArgs": ["--version"],
      "workspace": "/data/repos/project",
      "permissionPolicy": "ask"
    },
    "codex": {
      "protocol": "acp",
      "driver": "codex",
      "name": "Codex",
      "command": "codex-acp",
      "workspace": "/data/repos/project",
      "permissionPolicy": "ask"
    },
    "research": {
      "protocol": "a2a",
      "name": "Research Agent",
      "agentCardUrl": "http://192.168.1.20:8080/.well-known/agent-card.json",
      "preferredTransport": "auto",
      "auth": {
        "type": "none"
      },
      "timeoutMs": 60000
    }
  }
}
